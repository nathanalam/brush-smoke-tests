# PostHog analytics.
#
# All of these are OPTIONAL — the app ships with a working default project key,
# so Netlify needs no configuration for analytics to work. Override them to point
# a fork or a staging deploy at a different PostHog project.

# Project API key (public, write-only — safe to expose in the browser).
VITE_POSTHOG_KEY=phc_BY23i9WY2n7wn4jked5NkDZT2S8yewnipjddfy86FkWX

# Ingestion host. Use https://eu.i.posthog.com for EU cloud.
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Capture events from `npm run dev` too. Off by default so local browsing
# does not pollute conversion metrics.
# VITE_POSTHOG_DEV=true
